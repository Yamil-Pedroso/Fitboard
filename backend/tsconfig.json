{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2020",
    "module": "CommonJS",
    "baseUrl": ".",
    "rootDir": "./src",
    "paths": {
      "@/*": ["src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude":[
    "./node_modules"
  ],
}
